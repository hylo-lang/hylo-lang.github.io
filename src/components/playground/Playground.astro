---
/**
 * A runnable, editable Hylo snippet.
 *
 * Wraps a code fence, which renders as any other code block (titles, highlighted lines and the
 * like all work), and adds a button running it in the reader's browser with the compiler compiled
 * to WebAssembly, one editing it, and a link opening it in the full-screen playground.
 *
 *     // From a page in `src/content/docs/docs/<section>/`.
 *     import Playground from '../../../../components/playground/Playground.astro';
 *
 *     <Playground outputs="result ir" focus="main" expect="exit 42">
 *     ```hylo {3}
 *     public fun main() -> Int32 {
 *       var x = 40
 *       &x = x + 2
 *       return if x == 42 { 42 } else { 1 }
 *     }
 *     ```
 *     </Playground>
 *
 * The compiler is only downloaded when a reader runs a snippet, and is shared by every snippet on
 * the page.
 *
 * A snippet can compile code it does not show: fences marked `hidden` are compiled with those
 * shown, in order. Each fence goes into the file its `title` names, or into the snippet's own
 * file; fences of the same file follow one another in it. A snippet that `continues` another,
 * earlier on the page, which it names by its `name`, starts from all the files of that one; one
 * with `contributes={false}` still does, but leaves its own code out of those continuing it.
 *
 *     <Playground name="point" stopAfter="typing" expect="ok">
 *     ```hylo title="point.hylo"
 *     struct Point { … }
 *     ```
 *     </Playground>
 *
 *     <Playground continues="point" expect="exit 3">
 *     ```hylo hidden
 *     public fun main() -> Int32 {
 *     ```
 *     ```hylo
 *       Point(x: 1, y: 2).sum()
 *     ```
 *     ```hylo hidden
 *     }
 *     ```
 *     </Playground>
 *
 * A snippet showing fences of several files shows them as tabs, named after the files. Above the
 * code, a snippet says which earlier snippet it continues, linking to it, and which files it
 * compiles without showing them; above and below the code of a file, it says how much of the file
 * it does not show, and whether that continues the file from an earlier snippet.
 *
 * Only works in MDX pages: the code comes from the Markdown plugin
 * `src/plugins/playground-source.ts`, which documents how fences make files, sets `files` and
 * `shown` from them, and fails the build, naming the page and the line, if the slot is not `hylo`
 * code fences, at most one shown of each file, or if `continues` names no snippet earlier on the
 * page. The build also fails if `expect` is missing or not one of
 * its forms, or if another prop has a value it does not take. The site's tests then check that the
 * snippet does what `expect` says (`snippets.test.ts`).
 *
 * Renders a `<hylo-playground>` (`playground-element.ts`), which takes the settings and the code
 * from the `data-` attributes set here.
 */
import {
  CornerDownRight,
  Ellipsis,
  ExternalLink,
  EyeOff,
  LoaderCircle,
  Pencil,
  Play,
  RotateCcw,
} from '@lucide/astro';
import type { Phase } from '@hylo-lang/hylo-wasm/protocol';
import { DEFAULT_SETTINGS, OPTIMIZATION_LEVELS, PHASES } from './settings';
import type { SourceFile } from '@hylo-lang/hylo-wasm/protocol';
import {
  EXPECTATION_FORMS,
  lineCount,
  parseExpectation,
  type ShownFile,
} from './snippet';
import { VIEWS, VIEW_TITLES, type View } from './views';
import Stages from './Stages.astro';
import './playground.css';

interface Props {
  /**
   * What to show once the code has run, as a list or a space-separated string, in the order of
   * the tabs: `result` (the default: the exit status, what the program printed, and any
   * diagnostics), `diagnostics`, `raw-ir`, `ir`, `llvm` and `assembly`.
   */
  outputs?: View[] | string;
  /** Functions to show in Hylo IR, by name, rather than all of them. */
  focus?: string[] | string;
  /** LLVM's optimization level, 0 to 3; 0 by default. */
  optimization?: 0 | 1 | 2 | 3;
  /** Whether the program depends on the standard library; true by default. */
  standardLibrary?: boolean;
  /**
   * The phase after which to stop, for a snippet that is not a program: `typing` checks the code
   * without running it, `lowering` also shows its IR.
   */
  stopAfter?: Phase;
  /** Whether the reader may edit the code; true by default. */
  editable?: boolean;
  /**
   * What the snippet does, which the site's tests check it still does: `exit N`, `trap`, `error`
   * (it does not compile), or `ok` (it compiles, and runs if it is a program). Required.
   */
  expect: string;
  /** A name by which later snippets of the page can continue this one. */
  name?: string;
  /** The `name` of an earlier snippet of the page, whose files this one starts from. */
  continues?: string;
  /**
   * `false` iff a snippet continuing this one starts from what this one continues, without this
   * one's own code; true by default.
   */
  contributes?: boolean;
  /**
   * The files of the program as JSON (`SourceFile[]`), with the contents of those shown left out,
   * which `playground-source.ts` sets; not for authors to set.
   */
  files: string;
  /** The files shown as JSON (`ShownFile[]`), which `playground-source.ts` sets. */
  shown: string;
}

const {
  outputs = ['result'],
  focus = [],
  optimization = DEFAULT_SETTINGS.optimization,
  standardLibrary = DEFAULT_SETTINGS.standardLibrary,
  stopAfter,
  editable = true,
  expect,
  name,
  continues,
  files,
  shown,
} = Astro.props;

// Mistakes are reported as the site builds, rather than as a snippet that misbehaves. MDX does not
// check the props' types, so every prop is checked here.

/** Fails the build, saying `problem` and where. */
const fail = (problem: string): never => {
  throw new Error(`<Playground> in ${Astro.url.pathname}: ${problem}`);
};
/** Returns the items of `items`, a list or a string of items separated by spaces or commas. */
const splitList = (items: string[] | string): string[] =>
  (typeof items === 'string' ? items.split(/[\s,]+/) : items).filter((item) => item !== '');
const views = splitList(outputs) as View[];
if (views.length === 0) fail('`outputs` lists nothing to show');
for (const view of views) {
  if (!VIEWS.includes(view)) fail(`unknown output '${view}'`);
}
if (!OPTIMIZATION_LEVELS.includes(optimization)) {
  fail(`\`optimization={${optimization}}\` is not one of ${OPTIMIZATION_LEVELS.join(', ')}`);
}
if (stopAfter !== undefined && !PHASES.includes(stopAfter)) {
  fail(`\`stopAfter="${stopAfter}"\` is not one of ${PHASES.join(', ')}`);
}
if (expect === undefined) fail(`say what the snippet does with \`expect\`: ${EXPECTATION_FORMS}`);
if (parseExpectation(expect) === null) {
  fail(`\`expect="${expect}"\` is not one of ${EXPECTATION_FORMS}`);
}

if ([files, shown].some((code) => typeof code !== 'string')) {
  fail('no code: use it in an MDX page, where `src/plugins/playground-source.ts` gives it its code');
}
const program = JSON.parse(files) as SourceFile[];
const shownFiles = JSON.parse(shown) as ShownFile[];
/** The files compiled but not shown, from this snippet's hidden fences or the snippet it continues. */
const hiddenFiles = program
  .map((f) => f.name)
  .filter((f) => !shownFiles.some((shownFile) => shownFile.file === f));

// The slot is the code blocks of the fences shown, one after another, each of which Expressive Code
// renders as a `div.expressive-code`.
const blocks = (await Astro.slots.render('default'))
  .split(/(?=<div class="expressive-code")/)
  .filter((block) => block.trim() !== '');
if (blocks.length !== shownFiles.length) {
  fail(`expected a code block for each of ${shownFiles.length} files shown, found ${blocks.length}`);
}
const tabs = shownFiles.length > 1;

/** Returns `n` lines, in words. */
const lines = (n: number) => (n === 1 ? '1 line' : `${n} lines`);
/** The id of the snippet named `name`, which those continuing it link to. */
const anchor = (name: string) => `pg-${name}`;
---

<hylo-playground
  id={name && anchor(name)}
  data-views={views.join(',')}
  data-ir-functions={splitList(focus).join(',') || undefined}
  data-optimization={optimization}
  data-standard-library={String(standardLibrary)}
  data-stop-after={stopAfter}
  data-expect={expect}
  data-files={files}
  data-shown={shown}
  class="not-content"
>
  {
    (continues || hiddenFiles.length > 0) && (
      <p class="pg-context">
        {continues && (
          <span>
            <CornerDownRight class="pg-icon" aria-hidden="true" />
            Continues <a href={`#${anchor(continues)}`}>an earlier snippet</a>
          </span>
        )}
        {hiddenFiles.length > 0 && (
          <span>
            <EyeOff class="pg-icon" aria-hidden="true" />
            Also compiles{' '}
            {hiddenFiles.map((f, i) => (
              <>
                {i > 0 && ', '}
                <code>{f}</code>
              </>
            ))}
          </span>
        )}
      </p>
    )
  }
  <div data-part="files" class:list={['pg-files', { 'pg-has-tabs': tabs }]}>
    {
      tabs && (
        <div data-part="file-tabs" class="pg-file-tabs" role="tablist" aria-label="Files">
          {shownFiles.map((f, i) => (
            <button
              type="button"
              role="tab"
              data-file-tab={i}
              aria-selected={String(i === 0)}
              tabindex={i === 0 ? 0 : -1}
              title={f.continuedLines > 0 ? `Continues ${f.file} from an earlier snippet` : undefined}
            >
              {f.continuedLines > 0 && <Ellipsis class="pg-icon" aria-label="continued:" />}
              {f.file}
            </button>
          ))}
        </div>
      )
    }
    {
      shownFiles.map((f, i) => {
        const above = lineCount(f.prelude);
        const below = lineCount(f.epilogue);
        const hiddenAbove = above - f.continuedLines;
        return (
          <div
            data-file-panel={i}
            data-selected={i === 0 ? '' : undefined}
            role={tabs ? 'tabpanel' : undefined}
            aria-label={tabs ? f.file : undefined}
          >
            {above > 0 && (
              <p class="pg-hidden-code" data-continued={f.continuedLines > 0 ? '' : undefined}>
                <Ellipsis class="pg-icon" aria-hidden="true" />
                {f.continuedLines > 0
                  ? `Continues ${f.file} from an earlier snippet (${lines(f.continuedLines)})` +
                    (hiddenAbove > 0 ? `, and ${lines(hiddenAbove)} not shown` : '')
                  : `${lines(above)} not shown`}
              </p>
            )}
            <div data-part="source">
              <Fragment set:html={blocks[i]} />
            </div>
            {editable && <div data-part="editor" class="pg-editor" hidden />}
            {below > 0 && (
              <p class="pg-hidden-code">
                <Ellipsis class="pg-icon" aria-hidden="true" />
                {`${lines(below)} not shown`}
              </p>
            )}
          </div>
        );
      })
    }
  </div>
  <div class="pg-toolbar">
    <button type="button" data-part="run" class="pg-button pg-primary">
      <Play class="pg-icon pg-idle-icon" aria-hidden="true" />
      <LoaderCircle class="pg-icon pg-busy-icon" aria-hidden="true" />
      {stopAfter ? 'Check' : 'Run'}
    </button>
    {
      editable && (
        <>
          <button type="button" data-part="edit" class="pg-button">
            <Pencil class="pg-icon" aria-hidden="true" />
            Edit
          </button>
          <button type="button" data-part="reset" class="pg-button" hidden>
            <RotateCcw class="pg-icon" aria-hidden="true" />
            Reset
          </button>
        </>
      )
    }
    <Stages />
    <a data-part="open" class="pg-link" href="/playground/">
      Open in the playground
      <ExternalLink class="pg-icon" aria-hidden="true" />
    </a>
  </div>
  <p data-part="status-line" class="sr-only" role="status"></p>
  <div data-part="results" class="pg-results" hidden>
    {
      views.length > 1 && (
        <div data-part="view-tabs" class="pg-tabs" role="tablist" aria-label="Views">
          {views.map((view) => (
            <button type="button" role="tab" data-view={view}>
              {VIEW_TITLES[view]}
            </button>
          ))}
        </div>
      )
    }
    <div
      data-part="panel"
      class="pg-panel"
      role={views.length > 1 ? undefined : 'region'}
      aria-label={views.length > 1 ? undefined : VIEW_TITLES[views[0]]}
    >
    </div>
  </div>
</hylo-playground>

<script>
  import './playground-element';
</script>
