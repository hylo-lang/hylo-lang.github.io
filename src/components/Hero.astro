---
/**
 * Starlight's `Hero` component override (see `astro.config.ts`): Starlight's own hero, or the
 * home page's (`HomeHero.astro`) on a page whose front matter sets `homeHero: true` (see
 * `content.config.ts`). Takes no props, as Starlight's does not.
 */
import Default from '@astrojs/starlight/components/Hero.astro';
import HomeHero from './HomeHero.astro';
---

{Astro.locals.starlightRoute.entry.data.homeHero ? <HomeHero /> : <Default />}
