---
/**
 * Starlight's hero, except on the home page, which has its own (`HomeHero.astro`).
 */
import Default from '@astrojs/starlight/components/Hero.astro';
import HomeHero from './HomeHero.astro';

// The home page's slug is empty.
const isHome = Astro.locals.starlightRoute.id === '';
---

{isHome ? <HomeHero /> : <Default />}
